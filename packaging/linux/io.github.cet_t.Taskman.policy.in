<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>TaskMan (NixOS Fork)</vendor>
  <vendor_url>https://github.com/cet-t/taskman</vendor_url>
  <icon_name>utilities-system-monitor</icon_name>

  <action id="io.github.cet_t.Taskman.privileged-helper">
    <description>Run TaskMan privileged process control action</description>
    <message>Authentication is required to modify or terminate another user's process or raise process priority in TaskMan.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@helperPath@</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
